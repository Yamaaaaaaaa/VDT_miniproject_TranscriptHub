# ============================================================
# TranscriptHub - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your values
# DO NOT commit the actual .env file to version control!
# ============================================================

# -------------------- PostgreSQL --------------------
# Connection string for all microservices (shared across services)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/transcripthub

# -------------------- Service Ports --------------------
USERS_SERVICE_PORT=3001
IDENTITY_SERVICE_PORT=3002
FILE_SERVICE_PORT=3003
FILE_SERVICE_TCP_PORT=3004
TRANSCRIPT_SERVICE_TCP_PORT=3005
MEETING_SERVICE_TCP_PORT=3006
COLLAB_SERVICE_TCP_PORT=3007
WS_PORT=3008
API_GATEWAY_PORT=3000

# -------------------- Service Hosts (internal Docker network) --------------------
USERS_SERVICE_HOST=users-service
IDENTITY_SERVICE_HOST=identity-service
FILE_SERVICE_HOST=file-service
TRANSCRIPT_SERVICE_HOST=transcript-service
MEETING_SERVICE_HOST=meeting-service
COLLAB_SERVICE_HOST=collab-service

# -------------------- Redis --------------------
REDIS_HOST=redis
REDIS_PORT=6379

# -------------------- JWT Authentication --------------------
# ACCESS TOKEN - expires in 15 minutes
JWT_SECRET=YOUR_ACCESS_TOKEN_SECRET_HERE
JWT_EXPIRES_IN=15m

# REFRESH TOKEN - expires in 7 days
JWT_REFRESH_SECRET=YOUR_REFRESH_TOKEN_SECRET_HERE
JWT_REFRESH_EXPIRES_IN=7d

# -------------------- MinIO / S3 Storage --------------------
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=transcripthub-bucket

# Public URL for accessing uploaded files
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9100
MINIO_SERVER_URL=http://localhost:9100

# -------------------- Kafka --------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# -------------------- AI / Transcript Service --------------------
# Get your API key from: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash

# -------------------- Node Environment --------------------
NODE_ENV=development
