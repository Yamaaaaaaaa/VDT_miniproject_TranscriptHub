{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "roots": [
    "<rootDir>/apps/"
  ],
  "reporters": [
    "default",
    [
      "jest-junit",
      {
        "outputDirectory": "test-reports",
        "outputName": "junit-e2e.xml"
      }
    ]
  ]
}
